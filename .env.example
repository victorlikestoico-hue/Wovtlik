DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro
CHAT_AI_PROVIDER=deepseek
CHAT_AI_API_KEY=sk-...
CHAT_AI_MODEL=deepseek-v4-pro
AUDIO_AI_PROVIDER=openai
AUDIO_AI_API_KEY=sk-...
AUDIO_AI_MODEL=gpt-4o-transcribe
IMAGE_AI_PROVIDER=openai
IMAGE_AI_API_KEY=sk-...
IMAGE_AI_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://user:password@db:5432/whatsapp_bot
REDIS_URL=redis://redis:6379
TELEGRAM_BOT_TOKEN=123456:abc...
TELEGRAM_CHAT_ID=123456789
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=contraseña_segura
LOG_LEVEL=warn
# OAuth2 de Google (Calendar) — credenciales del cliente "Web application" en Google Cloud Console.
# El refresh_token NO va aquí: se obtiene una vez vía /api/google-oauth/start y se guarda en settings.
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=https://tu-dominio.com/api/google-oauth/callback

# Panel "Meta" — recibe envíos/respuestas del proyecto recordatorios-turnos.
# META_REMINDERS_API_KEY: clave compartida que valida el POST del GitHub Action.
# META_WEBHOOK_VERIFY_TOKEN: verify token configurado en el webhook de Meta for Developers.
META_REMINDERS_API_KEY=clave-secreta-larga
META_WEBHOOK_VERIFY_TOKEN=otra-clave-secreta

# Token fine-grained de GitHub (solo repo "recordatorios", permiso Actions: read/write)
# usado para disparar el workflow de recordatorios de turno cada 5 min, porque el
# schedule nativo de GitHub Actions no corre con la frecuencia configurada bajo carga.
GITHUB_RECORDATORIOS_TOKEN=github_pat_...

# --- SOLO PARA DESARROLLO (MODO PRUEBA DE SEGUIMIENTOS) ---
# Frecuencia con la que el scheduler busca candidatos de seguimiento (ej: 5000 = 5s, 60000 = 1m)
# DEV_FOLLOWUP_POLL_INTERVAL_MS=5000
# Antigüedad mínima del último mensaje de la IA para enviar seguimiento (ej: 5 = 5s, 3600 = 1 hora)
# DEV_FOLLOWUP_MIN_AGE_SECONDS=5
